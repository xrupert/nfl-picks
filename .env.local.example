# Copy this file to .env.local and fill in your real values.
# .env.local is gitignored — never commit real keys.

# --- Client (exposed to the browser; safe = anon/public keys only) ---
VITE_SUPABASE_URL=https://YOUR-PROJECT-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_public_key
VITE_ESPN_BASE=https://site.api.espn.com/apis/site/v2/sports/football/nfl

# --- Server only (seed script + Vercel cron). NEVER expose to the client. ---
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key
